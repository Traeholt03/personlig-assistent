    {
      "id": "4fbe0e11-5777-44ae-b402-1f9fd8864c3a",
      "name": "Find Conflicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nvar events = $('Get Events').all().map(function(i){return i.json;}).filter(function(e){ return e && e.start && e.start.dateTime && e.end && e.end.dateTime && e.status!=='cancelled'; });\nevents.sort(function(a,b){ return new Date(a.start.dateTime).getTime()-new Date(b.start.dateTime).getTime(); });\nvar alerted = $('Get Alerted Conflicts').all().map(function(i){return i.json;}).filter(function(r){return r && r.conflict_key;});\nvar seen = {};\nalerted.forEach(function(r){ seen[r.conflict_key]=true; });\nfunction fmt(e){ var s=new Date(e.start.dateTime).toLocaleString('da-DK',{weekday:'short',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Copenhagen'}); var en=new Date(e.end.dateTime).toLocaleTimeString('da-DK',{hour:'2-digit',minute:'2-digit',timeZone:'Europe/Copenhagen'}); return s+'-'+en+' '+(e.summary||'(uden titel)'); }\nvar out=[];\nfor(var i=0;i<events.length;i++){\n  var a=events[i];\n  var as=new Date(a.start.dateTime).getTime(), ae=new Date(a.end.dateTime).getTime();\n  for(var j=i+1;j<events.length;j++){\n    var b=events[j];\n    var bs=new Date(b.start.dateTime).getTime(), be=new Date(b.end.dateTime).getTime();\n    if(bs>=ae){ break; }\n    if(as<be && bs<ae){\n      var ids=[String(a.id||a.iCalUID||a.summary), String(b.id||b.iCalUID||b.summary)].sort();\n      var key=ids.join('__');\n      if(!seen[key]){\n        seen[key]=true;\n        out.push({ json: { conflict_key:key, details: fmt(a)+'  vs  '+fmt(b), alerted_at:(new Date()).toISOString() } });\n      }\n    }\n  }\n}\nreturn out;\n"
      },
      "executeOnce": true
    },
    {
      "id": "b41e1b9f-d721-4bb0-9df6-b5fe0f3d5cf7",
      "name": "Record Conflict",

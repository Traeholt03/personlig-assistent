            }
          ]
        }
      }
    },
    {
      "id": "836ccefc-ee0c-4b8b-a391-2268e2e82bca",
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nvar NL=String.fromCharCode(10);\nvar conflicts = $('Find Conflicts').all().map(function(i){return i.json;}).filter(function(c){return c && c.details;});\nif(!conflicts.length){ return []; }\nvar lines = conflicts.map(function(c){ return '- '+c.details; }).join(NL);\nvar text = '⚠️ *Dobbeltbooking opdaget*'+NL+'Du har overlappende aftaler:'+NL+lines+NL+NL+'Tjek kalenderen og flyt en af dem.';\nreturn [{ json: { chatId: 'YOUR_TELEGRAM_CHAT_ID', text: text } }];\n"
      },
      "executeOnce": true
    },
